{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckLink SDI input settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "persistent_id",
    "audio_channels"
  ],
  "properties": {
    "persistent_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})$"
    },
    "audio_channels": {
      "enum": [
        2,
        8,
        16
      ]
    },
    "audio_format": {
      "enum": [
        "S16LE",
        "S32LE"
      ],
      "default": "S32LE"
    },
    "measure_av": {
      "type": "boolean",
      "default": false
    }
  }
}
